<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:allyza.Views.Controls"
             xmlns:models="clr-namespace:allyza.Models"
             x:Class="allyza.Views.TransactionHistoryPage"
             Title="History"
             BackgroundColor="#A8D4F0"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="22,20,22,16" Spacing="0">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Transactions" FontSize="26" FontAttributes="Bold"
                               TextColor="#0A0A0A" FontFamily="Georgia"/>
                        <Label Text="Your complete money history" FontSize="14" TextColor="#2E6A90"/>
                    </VerticalStackLayout>
                    <ActivityIndicator Grid.Column="1"
                                       IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="#1A7BB9" WidthRequest="28" HeightRequest="28"/>
                </Grid>

                <!-- Summary Row -->
                <Grid ColumnDefinitions="*,8,*,8,*" Margin="0,0,0,20">

                    <!-- Income -->
                    <Border Grid.Column="0" BackgroundColor="#C8F0DC"
                            Stroke="#90D8B0" StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 14" Padding="12,10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Income" FontSize="12" TextColor="#1A6640" FontAttributes="Bold"/>
                            <Label Text="{Binding TotalIncomeDisplay}"
                                   FontSize="15" FontAttributes="Bold" TextColor="#0A0A0A"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Spent -->
                    <Border Grid.Column="2" BackgroundColor="#FAD4D4"
                            Stroke="#F0A8A8" StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 14" Padding="12,10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Spent" FontSize="12" TextColor="#8B2020" FontAttributes="Bold"/>
                            <Label Text="{Binding TotalExpensesDisplay}"
                                   FontSize="15" FontAttributes="Bold" TextColor="#0A0A0A"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Balance — prefix + amount both black -->
                    <!-- You may want to add the missing Balance column here if needed -->

                </Grid>

                <!-- Search bar -->
                <Border Stroke="#7BBDE0" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 14" BackgroundColor="#D6EEFA"
                        Padding="0" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="44,*,40">
                        <Label Grid.Column="0" Text="🔍" FontSize="16"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" Text="{Binding SearchText}"
                               Placeholder="Search by name, category, amount, date…"
                               PlaceholderColor="#6A9FBF" TextColor="#0A0A0A"
                               BackgroundColor="Transparent" FontSize="14"
                               Margin="0,10,0,10"/>
                        <Label Grid.Column="2" Text="✕" FontSize="15"
                               TextColor="#C0392B" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding SearchText, Converter={StaticResource NotNullBool}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearSearchCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>

                <!-- Date filter toggle -->
                <Border StrokeShape="RoundRectangle 14" Padding="14,10"
                        StrokeThickness="1.5" Margin="0,0,0,10">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding DateFilterActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1A7BB9"/>
                            <Setter Property="Stroke" Value="#1A7BB9"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding DateFilterActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="#D6EEFA"/>
                            <Setter Property="Stroke" Value="#7BBDE0"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleDateFilterCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="📅" FontSize="16" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding DateFilterLabel}"
                               FontSize="14" FontAttributes="Bold" TextColor="#0A0A0A"
                               VerticalOptions="Center" Margin="8,0,0,0"/>
                        <Label Grid.Column="2" FontSize="13" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding DateFilterActive}" Value="True">
                                    <Setter Property="Text" Value="✕ Clear"/>
                                    <Setter Property="TextColor" Value="White"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding DateFilterActive}" Value="False">
                                    <Setter Property="Text" Value="▾ Expand"/>
                                    <Setter Property="TextColor" Value="#2E6A90"/>
                                </DataTrigger>
                            </Label.Triggers>
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearDateFilterCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>

                <!-- Date range pickers -->
                <Border IsVisible="{Binding DateFilterActive}"
                        BackgroundColor="#D6EEFA" Stroke="#7BBDE0" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 14" Padding="16,12" Margin="0,0,0,14">
                    <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto">
                        <Label Grid.Column="0" Grid.Row="0" Text="From"
                               FontSize="12" FontAttributes="Bold" TextColor="#1A4F72" Margin="0,0,0,4"/>
                        <Label Grid.Column="2" Grid.Row="0" Text="To"
                               FontSize="12" FontAttributes="Bold" TextColor="#1A4F72" Margin="0,0,0,4"/>
                        <Border Grid.Column="0" Grid.Row="1" Stroke="#7BBDE0" StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 10" BackgroundColor="#B8DEFA" Padding="10,4">
                            <DatePicker Date="{Binding DateFrom}" TextColor="#0A0A0A"
                                        BackgroundColor="Transparent" Format="MMM d, yyyy" FontSize="13"/>
                        </Border>
                        <Label Grid.Column="1" Grid.Row="1" Text="→" FontSize="18"
                               TextColor="#1A4F72" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border Grid.Column="2" Grid.Row="1" Stroke="#7BBDE0" StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 10" BackgroundColor="#B8DEFA" Padding="10,4">
                            <DatePicker Date="{Binding DateTo}" TextColor="#0A0A0A"
                                        BackgroundColor="Transparent" Format="MMM d, yyyy" FontSize="13"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Type filter chips -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,20">
                    <HorizontalStackLayout Spacing="8">

                        <Border StrokeShape="RoundRectangle 20" Padding="16,8" StrokeThickness="1.5">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsAll}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#90C8E0"/>
                                    <Setter Property="Stroke" Value="#5AAACB"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsAll}" Value="False">
                                    <Setter Property="BackgroundColor" Value="#B8DEFA"/>
                                    <Setter Property="Stroke" Value="#7BBDE0"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="All"/>
                            </Border.GestureRecognizers>
                            <Label Text="All" FontSize="14" FontAttributes="Bold" TextColor="#0A0A0A"/>
                        </Border>

                        <Border StrokeShape="RoundRectangle 20" Padding="16,8" StrokeThickness="1.5">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsIncomeFilter}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#90D8B0"/>
                                    <Setter Property="Stroke" Value="#60C090"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsIncomeFilter}" Value="False">
                                    <Setter Property="BackgroundColor" Value="#B8DEFA"/>
                                    <Setter Property="Stroke" Value="#7BBDE0"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Income"/>
                            </Border.GestureRecognizers>
                            <Label Text="💰 Income" FontSize="14" FontAttributes="Bold" TextColor="#0A0A0A"/>
                        </Border>

                        <Border StrokeShape="RoundRectangle 20" Padding="16,8" StrokeThickness="1.5">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsExpenseFilter}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#F0A8A8"/>
                                    <Setter Property="Stroke" Value="#D88080"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsExpenseFilter}" Value="False">
                                    <Setter Property="BackgroundColor" Value="#B8DEFA"/>
                                    <Setter Property="Stroke" Value="#7BBDE0"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Expense"/>
                            </Border.GestureRecognizers>
                            <Label Text="💸 Expenses" FontSize="14" FontAttributes="Bold" TextColor="#0A0A0A"/>
                        </Border>

                        <Border StrokeShape="RoundRectangle 20" Padding="16,8" StrokeThickness="1.5">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsFixedFilter}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#F5D090"/>
                                    <Setter Property="Stroke" Value="#D4A850"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsFixedFilter}" Value="False">
                                    <Setter Property="BackgroundColor" Value="#B8DEFA"/>
                                    <Setter Property="Stroke" Value="#7BBDE0"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Fixed"/>
                            </Border.GestureRecognizers>
                            <Label Text="📌 Fixed Bills" FontSize="14" FontAttributes="Bold" TextColor="#0A0A0A"/>
                        </Border>

                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Empty state -->
                <VerticalStackLayout IsVisible="{Binding HasNoResults}"
                                     HorizontalOptions="Center" Spacing="8" Margin="0,30,0,0">
                    <Label Text="📭" FontSize="44" HorizontalOptions="Center"/>
                    <Label Text="No transactions found"
                           TextColor="#2E6A90" FontSize="15" HorizontalOptions="Center"/>
                    <Label Text="Try a different search or date range"
                           TextColor="#2E6A90" FontSize="13" HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <!-- Transaction list -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredTransactions}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:TransactionModel">
                            <Border BackgroundColor="#D6EEFA" Stroke="#7BBDE0"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14,12">
                                <Grid ColumnDefinitions="44,*,Auto">

                                    <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                            BackgroundColor="{Binding CategoryColor}"
                                            StrokeShape="RoundRectangle 10" Stroke="Transparent">
                                        <Label Text="{Binding CategoryIcon}" FontSize="18"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3"
                                                         VerticalOptions="Center" Margin="10,0,0,0">
                                        <Label Text="{Binding Title}"
                                               FontSize="15" FontAttributes="Bold" TextColor="#0A0A0A"
                                               LineBreakMode="TailTruncation"/>
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding CategoryName}"
                                                   FontSize="12" TextColor="#1A4F72"/>
                                            <Label Text="·" FontSize="12" TextColor="#5A9ABF"/>
                                            <Label Text="{Binding DateDisplay}"
                                                   FontSize="12" TextColor="#2E6A90"/>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Notes}" FontSize="12" TextColor="#2E6A90"
                                               IsVisible="{Binding Notes, Converter={StaticResource NotNullBool}}"/>
                                    </VerticalStackLayout>

                                    <!-- Amount card — type-colored background, black text -->
                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="End"
                                                         VerticalOptions="Center" Spacing="4">

                                        <Border StrokeThickness="1" StrokeShape="RoundRectangle 10"
                                                Padding="10,5" HorizontalOptions="End">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="income">
                                                    <Setter Property="BackgroundColor" Value="#C8F0DC"/>
                                                    <Setter Property="Stroke" Value="#90D8B0"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="expense">
                                                    <Setter Property="BackgroundColor" Value="#FAD4D4"/>
                                                    <Setter Property="Stroke" Value="#F0A8A8"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="fixed">
                                                    <Setter Property="BackgroundColor" Value="#FFF0C8"/>
                                                    <Setter Property="Stroke" Value="#F5D090"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <!-- Amount always black regardless of type -->
                                            <Label Text="{Binding AmountDisplay}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="#0A0A0A"
                                                   HorizontalOptions="End"/>
                                        </Border>

                                        <Label Text="✕" FontSize="13" TextColor="#C0392B"
                                               HorizontalOptions="End"
                                               IsVisible="{Binding IsDeleteable}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="1"/>
    </Grid>

</ContentPage>
