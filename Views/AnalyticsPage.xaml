<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:allyza.Views.Controls"
             xmlns:models="clr-namespace:allyza.Models"
             x:Class="allyza.Views.AnalyticsPage"
             Title="Analytics"
             BackgroundColor="#A8D4F0"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="22,20,22,16" Spacing="0">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Analytics" FontSize="26" FontAttributes="Bold"
                               TextColor="#0A0A0A" FontFamily="Georgia"/>
                        <Label Text="Understand your finances" FontSize="15" TextColor="#2E6A90"/>
                    </VerticalStackLayout>
                    <ActivityIndicator Grid.Column="1"
                                       IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="#1A7BB9" WidthRequest="28" HeightRequest="28"/>
                </Grid>

                <!-- Period chips -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,20">
                    <HorizontalStackLayout Spacing="8">

                        <Border StrokeShape="RoundRectangle 20" Padding="16,8" StrokeThickness="1.5">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsThisMonth}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#1A7BB9"/>
                                    <Setter Property="Stroke" Value="#1A7BB9"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsThisMonth}" Value="False">
                                    <Setter Property="BackgroundColor" Value="#B8DEFA"/>
                                    <Setter Property="Stroke" Value="#7BBDE0"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetPeriodCommand}" CommandParameter="This Month"/>
                            </Border.GestureRecognizers>
                            <Label Text="This Month" FontSize="15" FontAttributes="Bold" TextColor="#0A0A0A"/>
                        </Border>

                        

                        <Border StrokeShape="RoundRectangle 20" Padding="16,8" StrokeThickness="1.5">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsThisYear}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#1A7BB9"/>
                                    <Setter Property="Stroke" Value="#1A7BB9"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsThisYear}" Value="False">
                                    <Setter Property="BackgroundColor" Value="#B8DEFA"/>
                                    <Setter Property="Stroke" Value="#7BBDE0"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetPeriodCommand}" CommandParameter="This Year"/>
                            </Border.GestureRecognizers>
                            <Label Text="This Year" FontSize="15" FontAttributes="Bold" TextColor="#0A0A0A"/>
                        </Border>

                        <Border StrokeShape="RoundRectangle 20" Padding="16,8" StrokeThickness="1.5">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsAllTime}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#1A7BB9"/>
                                    <Setter Property="Stroke" Value="#1A7BB9"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsAllTime}" Value="False">
                                    <Setter Property="BackgroundColor" Value="#B8DEFA"/>
                                    <Setter Property="Stroke" Value="#7BBDE0"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetPeriodCommand}" CommandParameter="All Time"/>
                            </Border.GestureRecognizers>
                            <Label Text="All Time" FontSize="15" FontAttributes="Bold" TextColor="#0A0A0A"/>
                        </Border>

                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Summary Cards Row 1: Income + Expenses -->
                <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,12">
                    <Border Grid.Column="0" BackgroundColor="#C8F0DC"
                            Stroke="#4CAF82" StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 16" Padding="14,12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="💰 INCOME" FontSize="13" TextColor="#1A6640"
                                   CharacterSpacing="1" FontAttributes="Bold"/>
                            <Label Text="{Binding TotalIncomeDisplay}"
                                   FontSize="20" FontAttributes="Bold" TextColor="#0A0A0A"/>
                            <Label Text="earned" FontSize="13" TextColor="#2E6A90"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="#FAD4D4"
                            Stroke="#E8A0A0" StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 16" Padding="14,12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="💸 EXPENSES" FontSize="13" TextColor="#C06060"
                                   CharacterSpacing="1" FontAttributes="Bold"/>
                            <Label Text="{Binding TotalExpensesDisplay}"
                                   FontSize="20" FontAttributes="Bold" TextColor="#0A0A0A"/>
                            <Label Text="spent" FontSize="13" TextColor="#2E6A90"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Summary Cards Row 2: Fixed + Savings -->
                <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,20">
                    <Border Grid.Column="0" BackgroundColor="#FFF0C8"
                            Stroke="#D4A020" StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 16" Padding="14,12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📌 FIXED BILLS" FontSize="13" TextColor="#7A5A00"
                                   CharacterSpacing="1" FontAttributes="Bold"/>
                            <!-- TotalFixedDisplay = all active fixed (committed) -->
                            <Label Text="{Binding TotalFixedDisplay}"
                                   FontSize="20" FontAttributes="Bold" TextColor="#0A0A0A"/>
                            <!-- TotalFixedPaidDisplay = how much has been paid so far -->
                            <Label Text="{Binding TotalFixedPaidDisplay}"
                                   FontSize="13" TextColor="#2E6A90"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="#B8DEFA"
                            Stroke="#5A9ABF" StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 16" Padding="14,12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🏦 SAVINGS" FontSize="13" CharacterSpacing="1"
                                   FontAttributes="Bold" TextColor="#1A7BB9"/>
                            <!-- Always positive — NetSavingsLabel says Saved or Overspent -->
                            <Label Text="{Binding NetSavingsDisplay}"
                                   FontSize="20" FontAttributes="Bold" TextColor="#0A0A0A"/>
                            <!-- e.g. "35.0% · Saved" or "22.5% · Overspent" -->
                            <Label FontSize="13" TextColor="#2E6A90">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding SavingsRateDisplay}"/>
                                        <Span Text=" · "/>
                                        <Span Text="{Binding NetSavingsLabel}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Budget vs Spent Card -->
                <Border BackgroundColor="#D6EEFA" Stroke="#7BBDE0" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16" Padding="16,14" Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="14">

                        <Grid>
                            <Label Text="BUDGET vs EXPENSES"
           FontSize="15" TextColor="#1A4F72"
           CharacterSpacing="2" FontAttributes="Bold"/>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <!-- BudgetRatio is clamped 0–1 for the bar control -->
                            <ProgressBar Progress="{Binding BudgetRatio}"
                                         ProgressColor="{Binding BudgetStatusColor}"
                                         BackgroundColor="#B8DEFA" HeightRequest="10"/>
                            <Grid ColumnDefinitions="*,*,*">
                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                    <Label Text="Budget" FontSize="13" TextColor="#2E6A90"/>
                                    <Label Text="{Binding TotalBudget, StringFormat='₱{0:N2}'}"
                                           FontSize="15" FontAttributes="Bold" TextColor="#0A0A0A"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="1">
                                    <Label Text="Spent" FontSize="13" TextColor="#2E6A90" HorizontalOptions="Center"/>
                                    <Label Text="{Binding BudgetUsed, StringFormat='₱{0:N2}'}"
                                           FontSize="15" FontAttributes="Bold" TextColor="#0A0A0A"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" Spacing="1">
                                    <!-- BudgetRemainingLabel = "Remaining" or "Overspent" -->
                                    <Label Text="{Binding BudgetRemainingLabel}"
                                           FontSize="13" TextColor="#2E6A90" HorizontalOptions="End"/>
                                    <!-- Shows remaining when under, overspent amount when over -->
                                    <Label FontSize="15" FontAttributes="Bold"
                                           TextColor="{Binding BudgetStatusColor}"
                                           HorizontalOptions="End">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsOverBudget}" Value="True">
                                                <Setter Property="Text" Value="{Binding BudgetOverspentDisplay}"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsOverBudget}" Value="False">
                                                <Setter Property="Text" Value="{Binding BudgetRemainingDisplay}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Per-category budget rows -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding BudgetItems}" Spacing="14">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:BudgetModel">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="32,*,Auto">
                                            <Label Grid.Column="0" Text="{Binding CategoryIcon}"
                                                   FontSize="18" VerticalOptions="Center"/>
                                            <VerticalStackLayout Grid.Column="1" Spacing="1"
                                                                 Margin="8,0,0,0" VerticalOptions="Center">
                                                <Label Text="{Binding CategoryName}"
                                                       FontSize="15" FontAttributes="Bold" TextColor="#0A0A0A"/>
                                                <Label Text="{Binding UsageDisplay}"
                                                       FontSize="13" TextColor="#2E6A90"/>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" Spacing="2">
                                                <Label Text="{Binding RemainingDisplay}"
                                                       FontSize="15" FontAttributes="Bold"
                                                       TextColor="{Binding StatusColor}"
                                                       HorizontalOptions="End"/>
                                              
                                            </VerticalStackLayout>
                                        </Grid>
                                        <!-- UsageRatio clamped 0–1 for bar; StatusColor goes red when over -->
                                        <ProgressBar Progress="{Binding UsageRatio}"
                                                     ProgressColor="{Binding StatusColor}"
                                                     BackgroundColor="#B8DEFA" HeightRequest="6"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Income Usage Bar -->
                <Border BackgroundColor="#D6EEFA" Stroke="#7BBDE0" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16" Padding="16,14" Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="INCOME USAGE" FontSize="15" TextColor="#1A4F72"
                               CharacterSpacing="2" FontAttributes="Bold"/>
                        <!-- SpentRatio = (expenses + ALL active fixed) / income -->
                        <ProgressBar Progress="{Binding SpentRatio}"
                                     ProgressColor="{Binding SpentBarColor, Converter={StaticResource StringToColor}}"
                                     BackgroundColor="#B8DEFA" HeightRequest="10"/>
                        <!-- e.g. "65.0% of income used" -->
                        <Label Text="{Binding SpentRatioDisplay}"
                               FontSize="15" TextColor="{Binding SpentBarColor}" FontAttributes="Bold"/>
                        <HorizontalStackLayout Spacing="16">
                            <HorizontalStackLayout Spacing="6">
                                <BoxView Color="#4CAF82" WidthRequest="10" HeightRequest="10"
                                         CornerRadius="2" VerticalOptions="Center"/>
                                <Label Text="Income" FontSize="13" TextColor="#0A0A0A"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <BoxView Color="#E07070" WidthRequest="10" HeightRequest="10"
                                         CornerRadius="2" VerticalOptions="Center"/>
                                <Label Text="Expenses" FontSize="13" TextColor="#0A0A0A"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <BoxView Color="#D4A020" WidthRequest="10" HeightRequest="10"
                                         CornerRadius="2" VerticalOptions="Center"/>
                                <Label Text="Fixed" FontSize="13" TextColor="#0A0A0A"/>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Insight -->
                <Border IsVisible="{Binding HasInsight}"
                        BackgroundColor="#B8DEFA" Stroke="#1A7BB9"
                        StrokeThickness="1.5" StrokeShape="RoundRectangle 14"
                        Padding="16,12" Margin="0,0,0,16">
                    <Label Text="{Binding InsightText}"
                           FontSize="15" TextColor="#0A0A0A" LineBreakMode="WordWrap"/>
                </Border>

                <!-- 6-Month Trend -->
                <Border BackgroundColor="#D6EEFA" Stroke="#7BBDE0" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16" Padding="16,14"
                        Margin="0,0,0,16" IsVisible="{Binding HasTrend}">
                    <VerticalStackLayout Spacing="14">

                        <Label Text="6-MONTH TREND" FontSize="15" TextColor="#1A4F72"
                               CharacterSpacing="2" FontAttributes="Bold"/>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding MonthlyTrend}"
                                                   Spacing="10" HeightRequest="120">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:MonthlyTrendModel">
                                        <VerticalStackLayout WidthRequest="48" Spacing="4">
                                            <Grid HeightRequest="96" WidthRequest="48">
                                                <BoxView BackgroundColor="#4CAF82" CornerRadius="3"
                                                         WidthRequest="18" HorizontalOptions="Start"
                                                         VerticalOptions="End"
                                                         HeightRequest="{Binding IncomeRatio, Converter={StaticResource RatioToHeight}}"/>
                                                <BoxView BackgroundColor="#E07070" CornerRadius="3"
                                                         WidthRequest="18" HorizontalOptions="End"
                                                         VerticalOptions="End"
                                                         HeightRequest="{Binding ExpenseRatio, Converter={StaticResource RatioToHeight}}"/>
                                            </Grid>
                                            <Label Text="{Binding MonthLabel}" FontSize="13"
                                                   TextColor="#1A4F72" HorizontalOptions="Center" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="16">
                            <HorizontalStackLayout Spacing="6">
                                <BoxView Color="#4CAF82" WidthRequest="12" HeightRequest="12"
                                         CornerRadius="2" VerticalOptions="Center"/>
                                <Label Text="Income" FontSize="13" TextColor="#0A0A0A"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <BoxView Color="#E07070" WidthRequest="12" HeightRequest="12"
                                         CornerRadius="2" VerticalOptions="Center"/>
                                <Label Text="Expenses" FontSize="13" TextColor="#0A0A0A"/>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

               

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="1"/>
    </Grid>

</ContentPage>
