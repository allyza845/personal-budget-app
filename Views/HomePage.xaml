<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="allyza.Views.HomePage"
             BackgroundColor="#0F0F1A"
             Title="Home">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                         Spacing="14" Padding="36">

        <Image 
    Source="home.png"
    WidthRequest="64"
    HeightRequest="64"
    HorizontalOptions="Center"/>

        <Label Text="{Binding Greeting}"
               FontSize="26" FontAttributes="Bold" TextColor="White"
               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

        <Label Text="Personal Budget Management App."
               FontSize="16" TextColor="#9090B0"
               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

        <Label Text="You are signed in."
               FontSize="14" TextColor="#6060A0"
               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

        <BoxView BackgroundColor="#2A2A40" HeightRequest="1" Margin="0,12"/>

        <Label Text="This is the Home Screen"
               FontSize="15" FontAttributes="Bold" TextColor="#7C6FFF"
               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

        <Label Text="Go to the Profile tab to view and edit your account."
               FontSize="13" TextColor="#6060A0"
               HorizontalOptions="Center" HorizontalTextAlignment="Center"
               LineBreakMode="WordWrap"/>

    </VerticalStackLayout>

</ContentPage>