<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:allyza.Views.Controls"
             xmlns:models="clr-namespace:allyza.Models"
             x:Class="allyza.Views.AddExpensePage"
             Title="Expenses"
             BackgroundColor="#A8D4F0"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="22,20,22,16" Spacing="0">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Expenses" FontSize="26" FontAttributes="Bold"
                               TextColor="#0A0A0A" FontFamily="Georgia"/>
                        <Label Text="Track your expenses" FontSize="14" TextColor="#2E6A90"/>
                    </VerticalStackLayout>
                    <ActivityIndicator Grid.Column="1"
                                       IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="#1A7BB9" WidthRequest="28" HeightRequest="28"/>
                </Grid>

                <!-- Add Expense Card -->
                <Border BackgroundColor="#D6EEFA" Stroke="#7BBDE0" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 20" Padding="20" Margin="0,0,0,20">
                    <VerticalStackLayout Spacing="16">

                        <Label Text="ADD NEW EXPENSE" TextColor="#1A4F72"
                               FontSize="13" CharacterSpacing="2" FontAttributes="Bold"/>

                        <!-- Amount -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Amount" TextColor="#1A4F72" FontSize="13" FontAttributes="Bold"/>
                            <Border Stroke="#7BBDE0" StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 14" BackgroundColor="#B8DEFA" Padding="0">
                                <Grid ColumnDefinitions="44,*">
                                    <Label Grid.Column="0" Text="₱" FontSize="18" FontAttributes="Bold"
                                           TextColor="#1A4F72" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Entry Grid.Column="1" Text="{Binding AmountText}"
                                           Placeholder="0.00" PlaceholderColor="#6A9FBF"
                                           TextColor="#0A0A0A" FontSize="22" FontAttributes="Bold"
                                           Keyboard="Numeric" BackgroundColor="Transparent"
                                           Margin="0,10,14,10"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Description -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Description" TextColor="#1A4F72" FontSize="13" FontAttributes="Bold"/>
                            <Border Stroke="#7BBDE0" StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 14" BackgroundColor="#B8DEFA" Padding="14,10">
                                <Entry Text="{Binding Description}"
                                       Placeholder="e.g. Lunch, Grab fare…"
                                       PlaceholderColor="#6A9FBF" TextColor="#0A0A0A"
                                       FontSize="15" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Category chips -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Category" TextColor="#1A4F72" FontSize="13" FontAttributes="Bold"/>
                            <FlexLayout BindableLayout.ItemsSource="{Binding Categories}"
                                        Wrap="Wrap" Direction="Row" JustifyContent="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:CategoryModel">
                                        <Border StrokeShape="RoundRectangle 20" Padding="12,6"
                                                StrokeThickness="1.5" Margin="0,0,8,8">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="{Binding Color}"/>
                                                    <Setter Property="Stroke" Value="{Binding Color}"/>
                                                    <Setter Property="Opacity" Value="0.75"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{Binding Color}"/>
                                                    <Setter Property="Stroke" Value="#1A4F72"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCategoryCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                <Label Text="{Binding Icon}" FontSize="14" VerticalOptions="Center"/>
                                                <Label Text="{Binding Name}" FontSize="13"
                                                       FontAttributes="Bold" TextColor="#0A0A0A"
                                                       VerticalOptions="Center"/>
                                                <Label Text="✓" FontSize="13" TextColor="#1A4F72"
                                                       VerticalOptions="Center"
                                                       IsVisible="{Binding IsSelected}"/>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Date -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Date" TextColor="#1A4F72" FontSize="13" FontAttributes="Bold"/>
                            <Border Stroke="#7BBDE0" StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 14" BackgroundColor="#B8DEFA" Padding="14,4">
                                <DatePicker Date="{Binding Date}" TextColor="#0A0A0A"
                                            BackgroundColor="Transparent"
                                            Format="MMMM d, yyyy" FontSize="15"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Notes -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Notes (optional)" TextColor="#1A4F72" FontSize="13" FontAttributes="Bold"/>
                            <Border Stroke="#7BBDE0" StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 14" BackgroundColor="#B8DEFA" Padding="14,8">
                                <Editor Text="{Binding Notes}" Placeholder="Any details…"
                                        PlaceholderColor="#6A9FBF" TextColor="#0A0A0A"
                                        FontSize="15" BackgroundColor="Transparent"
                                        AutoSize="TextChanges" MinimumHeightRequest="60"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Error / Success -->
                        <Label Text="{Binding ErrorMessage}" TextColor="#C0392B"
                               FontSize="13" IsVisible="{Binding HasError}"/>
                        <Label Text="{Binding SuccessMessage}" TextColor="#1A6640"
                               FontSize="13" IsVisible="{Binding HasSuccess}"
                               HorizontalOptions="Center" FontAttributes="Bold"/>

                        <!-- Buttons -->
                        <Grid ColumnDefinitions="*,16,*" Margin="0,4,0,0">
                            <Button Grid.Column="0" Text="CLEAR" Command="{Binding ClearCommand}"
                                    BackgroundColor="#B8DEFA" TextColor="#1A4F72"
                                    BorderColor="#7BBDE0" BorderWidth="1.5"
                                    CornerRadius="14" HeightRequest="50"
                                    FontAttributes="Bold" FontSize="17"/>
                            <Button Grid.Column="2" Text="SAVE EXPENSES " Command="{Binding SaveCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    BackgroundColor="#1A7BB9" TextColor="White"
                                    FontAttributes="Bold" FontSize="17"
                                    CornerRadius="14" HeightRequest="50"
                                    Shadow="{Shadow Brush='#801A7BB9', Offset='0,4', Radius='10'}"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Recent Expenses -->
                <Label Text="RECENT EXPENSES" TextColor="#1A4F72"
                       FontSize="13" CharacterSpacing="2" FontAttributes="Bold" Margin="0,0,0,12"/>

                <VerticalStackLayout IsVisible="{Binding HasNoExpenses}"
                                     HorizontalOptions="Center" Spacing="8" Margin="0,20,0,20">
                    <Label Text="📭" FontSize="40" HorizontalOptions="Center"/>
                    <Label Text="No expenses recorded yet"
                           TextColor="#2E6A90" FontSize="14" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Expenses}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ExpenseModel">
                            <Border BackgroundColor="#D6EEFA" Stroke="#7BBDE0"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14,12">
                                <Grid ColumnDefinitions="44,*,Auto">

                                    <!-- Category icon bubble -->
                                    <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                            BackgroundColor="{Binding CategoryColor}"
                                            StrokeShape="RoundRectangle 10" Stroke="Transparent">
                                        <Label Text="{Binding CategoryIcon}" FontSize="18"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <!-- Description + meta -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="3"
                                                         VerticalOptions="Center" Margin="10,0,0,0">
                                        <Label Text="{Binding Description}"
                                               FontSize="15" FontAttributes="Bold" TextColor="#0A0A0A"
                                               LineBreakMode="TailTruncation"/>
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding CategoryName}"
                                                   FontSize="12" TextColor="#1A4F72"/>
                                            <Label Text="·" FontSize="12" TextColor="#5A9ABF"/>
                                            <Label Text="{Binding DateDisplay}"
                                                   FontSize="12" TextColor="#2E6A90"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Amount + delete — pastel blue card -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="6"
                                                         HorizontalOptions="End" VerticalOptions="Center">

                                        <Border BackgroundColor="#B8DEFA" Stroke="#7BBDE0"
                                                StrokeThickness="1" StrokeShape="RoundRectangle 10"
                                                Padding="10,5" HorizontalOptions="End">
                                            <Label Text="{Binding AmountDisplay}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="#1A4F72"/>
                                        </Border>

                                        <Label Text="✕" FontSize="13" TextColor="#C0392B"
                                               HorizontalOptions="End">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteExpenseCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="1"/>
    </Grid>

</ContentPage>
