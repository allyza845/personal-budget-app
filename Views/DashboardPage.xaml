<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:allyza.Views.Controls"
             xmlns:models="clr-namespace:allyza.Models"
             x:Class="allyza.Views.DashboardPage"
             BackgroundColor="#A8D4F0"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="22,48,22,16" Spacing="0">

                <!-- HEADER -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">

                    <!-- Profile Icon (left) -->
                    <Border Grid.Column="0"
                            WidthRequest="46" HeightRequest="46"
                            BackgroundColor="#5BA8D8"
                            Stroke="#2E6A90" StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 14"
                            VerticalOptions="Center"
                            Margin="0,0,12,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfileTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="👤" FontSize="22"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- Greeting + Date -->
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding GreetingText}"
                               FontSize="22" FontAttributes="Bold"
                               TextColor="#0A0A0A" FontFamily="Georgia"/>
                        <Label Text="{Binding TodayLabel}"
                               FontSize="14" TextColor="#2E6A90"/>
                    </VerticalStackLayout>

                    <!-- Activity Indicator (right) -->
                    <ActivityIndicator Grid.Column="2"
                                       IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#1A7BB9" WidthRequest="28" HeightRequest="28"
                                       VerticalOptions="Center"/>
                </Grid>

                <!-- BALANCE CARD -->
                <Border BackgroundColor="#D6EEFA" Stroke="#7BBDE0" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 20" Padding="20,18" Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding MonthLabel, StringFormat='Balance · {0}'}"
                                   FontSize="15" TextColor="#2E6A90" CharacterSpacing="1"/>
                            <Label Grid.Column="1" Text="THIS MONTH"
                                   FontSize="13" TextColor="#5A9ABF" CharacterSpacing="1"/>
                        </Grid>

                        <!-- Net balance -->
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding NetBalancePrefix}"
                                   FontSize="28" FontAttributes="Bold"
                                   TextColor="#0A0A0A"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding NetBalanceDisplay}"
                                   FontSize="32" FontAttributes="Bold"
                                   TextColor="#0A0A0A"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <!-- Budget bar -->
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Budget usage"
                                       FontSize="15" TextColor="#1A4F72"/>
                                <Label Grid.Column="1"
                                      Text="{Binding SpentPercentDisplay}"
                                      FontSize="15" TextColor="#0A0A0A"/>
                            </Grid>
                            <ProgressBar Progress="{Binding SpentRatio}"
                                        ProgressColor="#1A7BB9"
                                         BackgroundColor="#B8DEFA"
                                         HeightRequest="8"/>
                        </VerticalStackLayout>

                        <!-- 3 stat mini cards -->
                        <Grid ColumnDefinitions="*,8,*,8,*">
                            <Border Grid.Column="0" BackgroundColor="#C8F0DC"
                                    Stroke="#4CAF82" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12" Padding="10,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Income" FontSize="13" TextColor="#1A6640"/>
                                    <Label Text="{Binding MonthlyIncomeDisplay}"
                                           FontSize="15" FontAttributes="Bold" TextColor="#0A0A0A"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="#FAD4D4"
                                    Stroke="#E07070" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12" Padding="10,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Spent" FontSize="13" TextColor="#8B2020"/>
                                    <Label Text="{Binding MonthlyExpensesDisplay}"
                                           FontSize="15" FontAttributes="Bold" TextColor="#0A0A0A"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="4" BackgroundColor="#FFF0C8"
                                    Stroke="#D4A020" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12" Padding="10,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Fixed" FontSize="13" TextColor="#7A5A00"/>
                                    <Label Text="{Binding MonthlyFixedDisplay}"
                                           FontSize="15" FontAttributes="Bold" TextColor="#0A0A0A"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- DAILY SPENT CARD -->
                <Border BackgroundColor="#D6EEFA" Stroke="#7BBDE0" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 20" Padding="18,16" Margin="0,0,0,20">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="🗓️  TODAY'S SPENDING" FontSize="12"
                               TextColor="#1A4F72" CharacterSpacing="2" FontAttributes="Bold"/>

                        <Grid ColumnDefinitions="*,Auto">

                            <!-- Left: big amount + trend -->
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="{Binding TodaySpentDisplay}"
                                       FontSize="30" FontAttributes="Bold" TextColor="#0A0A0A"/>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding DailyTrendIcon}"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="{Binding DailyTrendColor}"
                                           VerticalOptions="Center"/>
                                    <Label Text="{Binding DailyTrendLabel}"
                                           FontSize="13" TextColor="{Binding DailyTrendColor}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Right: this week pill -->
                            <Border Grid.Column="1"
                                    BackgroundColor="#B8DEFA" Stroke="#7BBDE0" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12" Padding="12,8"
                                    VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="This Week" FontSize="11"
                                           TextColor="#1A4F72" FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding WeekSpentDisplay}"
                                           FontSize="15" FontAttributes="Bold"
                                           TextColor="#0A0A0A" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                        <!-- Yesterday row -->
                        <Border BackgroundColor="#B8DEFA" Stroke="#7BBDE0"
                                StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Yesterday's spending"
                                       FontSize="13" TextColor="#0A0A0A" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding YesterdaySpentDisplay}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="#0A0A0A" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- BILLS STATUS CHIPS -->
                <HorizontalStackLayout Spacing="10" Margin="0,0,0,20">

                    <Border BackgroundColor="#FAD4D4" Stroke="#E07070"
                            StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,9"
                            IsVisible="{Binding HasOverdue}">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="🔴" FontSize="14"/>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="{Binding OverdueCount, StringFormat='{0} Overdue'}"
                                       FontSize="15" FontAttributes="Bold" TextColor="#8B2020"/>
                                <Label Text="bills" FontSize="13" TextColor="#2E6A90"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="#FFF0C8" Stroke="#D4A020"
                            StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,9"
                            IsVisible="{Binding HasUpcoming}">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="🟡" FontSize="14"/>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="{Binding UpcomingCount, StringFormat='{0} Upcoming'}"
                                       FontSize="15" FontAttributes="Bold" TextColor="#7A5A00"/>
                                <Label Text="within 7 days" FontSize="13" TextColor="#2E6A90"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="#C8F0DC" Stroke="#4CAF82"
                            StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,9"
                            IsVisible="{Binding HasPaid}">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="✅" FontSize="14"/>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="{Binding PaidCount, StringFormat='{0} Paid'}"
                                       FontSize="15" FontAttributes="Bold" TextColor="#1A6640"/>
                                <Label Text="this month" FontSize="13" TextColor="#2E6A90"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                </HorizontalStackLayout>

                <!-- OVERDUE BILLS -->
                <VerticalStackLayout IsVisible="{Binding HasOverdue}" Margin="0,0,0,16">
                    <Label Text="🔴  OVERDUE BILLS" TextColor="#8B2020"
                           FontSize="15" CharacterSpacing="2" FontAttributes="Bold" Margin="0,0,0,10"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding OverdueBills}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:FixedExpenseModel">
                                <Border BackgroundColor="#FAD4D4" Stroke="#E07070"
                                        StrokeThickness="1.5" StrokeShape="RoundRectangle 16" Padding="14,12">
                                    <Grid ColumnDefinitions="40,*,Auto">
                                        <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                                BackgroundColor="{Binding CategoryColor}"
                                                StrokeShape="RoundRectangle 10" Stroke="Transparent">
                                            <Label Text="{Binding CategoryIcon}" FontSize="17"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3"
                                                             Margin="10,0,0,0" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontSize="20"
                                                   FontAttributes="Bold" TextColor="#0A0A0A"/>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding DaysUntilDue}"
                                                       FontSize="15" TextColor="#8B2020"/>
                                                <Label Text="·" FontSize="15" TextColor="#5A9ABF"/>
                                                <Label Text="{Binding Frequency}"
                                                       FontSize="15" TextColor="#1A4F72"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="End"
                                                             VerticalOptions="Center" Spacing="6">
                                            <Label Text="{Binding AmountDisplay}"
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#0A0A0A" HorizontalOptions="End"/>
                                            <Border BackgroundColor="#C8F0DC" Stroke="#4CAF82"
                                                    StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                                    Padding="8,4">
                                                <Label Text="Mark Paid" FontSize="15" TextColor="#1A6640">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarkPaidCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- UPCOMING BILLS -->
                <VerticalStackLayout IsVisible="{Binding HasUpcoming}" Margin="0,0,0,16">
                    <Label Text="🟡  UPCOMING (7 DAYS)" TextColor="#7A5A00"
                           FontSize="15" CharacterSpacing="2" FontAttributes="Bold" Margin="0,0,0,10"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding UpcomingBills}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:FixedExpenseModel">
                                <Border BackgroundColor="#FFF0C8" Stroke="#D4A020"
                                        StrokeThickness="1.5" StrokeShape="RoundRectangle 16" Padding="14,12">
                                    <Grid ColumnDefinitions="40,*,Auto">
                                        <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                                BackgroundColor="{Binding CategoryColor}"
                                                StrokeShape="RoundRectangle 10" Stroke="Transparent">
                                            <Label Text="{Binding CategoryIcon}" FontSize="17"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3"
                                                             Margin="10,0,0,0" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontSize="20"
                                                   FontAttributes="Bold" TextColor="#0A0A0A"/>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding DaysUntilDue}"
                                                       FontSize="15" TextColor="#7A5A00"/>
                                                <Label Text="·" FontSize="15" TextColor="#5A9ABF"/>
                                                <Label Text="{Binding DueDayDisplay}"
                                                       FontSize="15" TextColor="#1A4F72"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="End"
                                                             VerticalOptions="Center" Spacing="6">
                                            <Label Text="{Binding AmountDisplay}"
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#0A0A0A" HorizontalOptions="End"/>
                                            <Border BackgroundColor="#C8F0DC" Stroke="#4CAF82"
                                                    StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                                    Padding="8,4">
                                                <Label Text="Mark Paid" FontSize="15" TextColor="#1A6640">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarkPaidCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- PAID BILLS -->
                <VerticalStackLayout IsVisible="{Binding HasPaid}" Margin="0,0,0,16">
                    <Label Text="✅  PAID THIS MONTH" TextColor="#1A6640"
                           FontSize="15" CharacterSpacing="2" FontAttributes="Bold" Margin="0,0,0,10"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PaidBills}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:FixedExpenseModel">
                                <Border BackgroundColor="#C8F0DC" Stroke="#4CAF82"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14,12">
                                    <Grid ColumnDefinitions="40,*,Auto">
                                        <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                                BackgroundColor="{Binding CategoryColor}"
                                                StrokeShape="RoundRectangle 10" Stroke="Transparent">
                                            <Label Text="{Binding CategoryIcon}" FontSize="17"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3"
                                                             Margin="10,0,0,0" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontSize="20"
                                                   FontAttributes="Bold" TextColor="#2A2A2A"/>
                                            <Label Text="Paid this month ✓"
                                                   FontSize="15" TextColor="#1A6640"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="End"
                                                             VerticalOptions="Center" Spacing="6">
                                            <Label Text="{Binding AmountDisplay}"
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#0A0A0A" HorizontalOptions="End"/>
                                            <Label Text="Undo" FontSize="15" TextColor="#5A9ABF"
                                                   HorizontalOptions="End">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarkUnpaidCommand}"
                                                        CommandParameter="{Binding .}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- SCHEDULED BILLS -->
                <VerticalStackLayout IsVisible="{Binding HasScheduled}" Margin="0,0,0,20">
                    <Label Text="📅  SCHEDULED" TextColor="#1A4F72"
                           FontSize="15" CharacterSpacing="2" FontAttributes="Bold" Margin="0,0,0,10"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ScheduledBills}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:FixedExpenseModel">
                                <Border BackgroundColor="#D6EEFA" Stroke="#7BBDE0"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14,12">
                                    <Grid ColumnDefinitions="40,*,Auto">
                                        <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                                BackgroundColor="{Binding CategoryColor}"
                                                StrokeShape="RoundRectangle 10" Stroke="Transparent">
                                            <Label Text="{Binding CategoryIcon}" FontSize="17"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3"
                                                             Margin="10,0,0,0" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontSize="20"
                                                   FontAttributes="Bold" TextColor="#0A0A0A"/>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding DaysUntilDue}"
                                                       FontSize="15" TextColor="#2E6A90"/>
                                                <Label Text="·" FontSize="15" TextColor="#5A9ABF"/>
                                                <Label Text="{Binding DueDayDisplay}"
                                                       FontSize="15" TextColor="#1A4F72"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{Binding AmountDisplay}"
                                               FontSize="20" FontAttributes="Bold"
                                               TextColor="#1A4F72" VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- RECENT TRANSACTIONS -->
                <VerticalStackLayout IsVisible="{Binding HasRecentTxns}" Margin="0,0,0,8">
                    <Label Text="🕐  RECENT TRANSACTIONS" TextColor="#1A4F72"
                           FontSize="15" CharacterSpacing="2" FontAttributes="Bold" Margin="0,0,0,10"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentTxns}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TransactionModel">
                                <Border BackgroundColor="#D6EEFA" Stroke="#7BBDE0"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14,11">
                                    <Grid ColumnDefinitions="38,*,Auto">
                                        <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                                BackgroundColor="{Binding CategoryColor}"
                                                StrokeShape="RoundRectangle 10" Stroke="Transparent">
                                            <Label Text="{Binding CategoryIcon}" FontSize="17"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2"
                                                             Margin="10,0,0,0" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" FontSize="20"
                                                   FontAttributes="Bold" TextColor="#0A0A0A"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding DateDisplay}"
                                                   FontSize="15" TextColor="#2E6A90"/>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{Binding AmountDisplay}"
                                               FontSize="20" FontAttributes="Bold"
                                               TextColor="#0A0A0A"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="1"/>
    </Grid>

</ContentPage>
